# ─────────────────────────────────────────────────────────────
#  Gesaivan Market Management System — Environment Variables
#  Copy this file to .env and fill in your own values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# Flask secret key — change to a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# MongoDB connection URI
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DB=gesaivan_market

# Flask environment: development | production
FLASK_ENV=development

# Port to run the app on
PORT=5000
